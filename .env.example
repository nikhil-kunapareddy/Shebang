# ==============================================================================
# Shebang configuration - Vercel AI Gateway & Jev model
# Copy to ~/Library/Application Support/Shebang/.env (or next to Shebang.app).
# Variables already set in the environment win over this file.
# ==============================================================================

# [REQUIRED unless saved in the app] Your Vercel AI Gateway API key
# Generated from 'npx vercel ai-gateway setup' or copied from:
# https://vercel.com/dashboard -> AI Gateway -> API Keys
AI_GATEWAY_API_KEY=

# [OPTIONAL] AI Gateway endpoint & model
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh
JEV_MODEL=typesafe-ai/jev

# [OPTIONAL] Privacy: when true, requests providerOptions.gateway.zeroDataRetention
ZERO_DATA_RETENTION=false

# [OPTIONAL] Below this confidence (0.0 to 1.0) Jev asks you instead of acting
DECISION_CONFIDENCE_THRESHOLD=0.0

# [OPTIONAL] Execution mode & limits. Defaults: the app acts for real with no step
# limit; the shebang CLI simulates and stops after 10 steps.
# DRY_RUN=true
# MAX_STEPS_PER_RUN=30

# [OPTIONAL] Set to 1 to enable live tests that call Vercel AI Gateway
JEV_LIVE_TESTS=0
